# ---------------------------------------------------------------------------
# Gradle
# ---------------------------------------------------------------------------
.gradle/
build/
*/build/

# Gradle Wrapper 发行版属于本地下载的缓存，不应入库。
# 历史提交曾误将 gradle-8.2 完整发行版（260MB）纳入版本库，此处显式排除。
gradle/wrapper/dist/**
gradle/wrapper/*.zip

# 但 gradle-wrapper.jar 与 properties 是构建必需的，必须入库。
# 需要逐级放开父目录，否则父目录被整体排除后反向规则不会生效。
!gradle/wrapper/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
local.properties
*.apk
*.aab
*.ap_
*.dex

# 签名文件
*.jks
*.keystore
key.properties

# 混淆映射与归档文件
mapping.txt
seeds.txt
shrunk_resources.jar
output.json

